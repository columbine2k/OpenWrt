# Target Config
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_MULTI_PROFILE=y
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_ezpro_mrkaio-m68s is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_ezpro_mrkaio-m68s-plus is not set
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_fastrhino_r66s=y
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_fastrhino_r68s is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_firefly_station-p2 is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-neo3 is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2c is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r4s is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r4se is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r5c is not set
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r5s=y
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h66k is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h69k is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_lyt_t68m is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_xunlong_orangepi-r1-plus is not set
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_xunlong_orangepi-r1-plus-lts is not set

# Set Firmware Size
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=960

# Firmware Type
CONFIG_TARGET_ROOTFS_TARGZ=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# 修复 LEDE 6.12 内核缺失 stmmac（原生千兆网卡）驱动
# 导致 R5S 千兆口无驱动、eth 编号前移、网口映射与丝印错位
CONFIG_KERNEL_NET_VENDOR_STMICRO=y
CONFIG_KERNEL_STMMAC_ETH=y
CONFIG_KERNEL_STMMAC_PLATFORM=y
CONFIG_KERNEL_DWMAC_GENERIC=y
CONFIG_KERNEL_DWMAC_ROCKCHIP=y

# luci-app-wrtbwmon（从 shared/extra.config 移入，保持 LEDE rockchip 行为不变）
CONFIG_PACKAGE_luci-app-wrtbwmon=y
